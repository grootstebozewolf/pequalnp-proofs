/-! Orbit-exclusion witness table for 3x3, d = 4 (generated by r8/gen_wtable.py). Core Lean only.
Pivot sets = 9-bit masks, omega(I) = mask value (colex). The table is a list of digits (chunks of 1000): digit k belongs to the k-th
d-subset in increasing order; digit = σ-index * 6 + τ-index of a lowering (σ,τ), or 36 for an orbit representative. -/
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
namespace WT334
def q : Nat := 3
def rowPerms : List (List Nat) := [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]]
def colPerms : List (List Nat) := [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]]
def act (σ τ : List Nat) (m : Nat) : Nat :=
  (List.range 9).foldl (fun acc c => if m.testBit c then acc + 2 ^ (σ.getD (c / q) 0 * q + τ.getD (c % q) 0) else acc) 0
/-- all d-subsets of range n as masks; increasing by construction (first block < 2^n <= second block) -/
def subsets : Nat → Nat → List Nat
  | _, 0 => [0]
  | 0, _ + 1 => []
  | n + 1, k + 1 => (subsets n (k + 1)) ++ ((subsets n k).map (· + 2 ^ n))
def c0 : List Nat := [36,2,36,36,2,3,1,1,3,4,5,4,12,14,15,6,36,1,36,36,36,8,12,12,13,1,1,9,13,12,13,12,26,27,24,8,2,6,2,2,2,4,14,14,16,4,11,4,24,14,29,14,16,16,26,6,6,8,18,18,19,20,20,22,24,31,34,21,24,26,9,7,3,3,10,5,5,25,28,15,3,3,5,15,17,15,15,17,17,27,7,7,9,19,18,19,30,20,35,25,21,23,21,25,27,10,11,10,18,32,33,20,22,22,28,21,23,23,29,28,18,20,21,30,32,33]
def digits : List Nat := c0
def okH (h m : Nat) : Bool := h == 36 || decide (act (rowPerms.getD (h / 6) []) (colPerms.getD (h % 6) []) m < m)
def go : List Nat → List Nat → Nat → Bool
  | [], [], r => r == 7
  | m :: ms, h :: hs, r => okH h m && go ms hs (if h == 36 then r + 1 else r)
  | _, _, _ => false
def check : Bool := go (subsets 9 4) digits 0
theorem check_ok : check = true := by decide +kernel
end WT334
#print axioms WT334.check_ok
