  obtain ⟨C, hC, y, hy⟩ := chart (![b 0, b 2, a 1, a 4] : Fin 4 → P →ₗ[ℂ] ℂ) inj hP
  have hCm : C ∈ (Finset.univ : Finset (Fin 4)).powersetCard 3 :=
