/-- The finite core of vJ: in the branch `∑ b = 0`, dimension at most two. -/
theorem core (a b : Fin 5 → P →ₗ[ℂ] ℂ)
    (E : ∀ x, (∀ i, a i x = 0) → (∀ i, b i x = 0) → x = 0)
    (hb : ∀ x, ∑ j, b j x = 0)
    (hS : ∀ i, b i = 0 ∨ ∀ x, 2 * a i x = ∑ j, a j x)
    (M : ∀ x j, g3 j (fun i => a i x) + g3 j (fun i => b i x) = 0) :
    finrank ℂ P ≤ 2 := by
  by_contra hP
  replace hP : 2 < finrank ℂ P := by omega
  rcases hS 0 with h0 | h0 <;> rcases hS 1 with h1 | h1 <;> rcases hS 2 with h2 | h2 <;>
    rcases hS 3 with h3 | h3 <;> rcases hS 4 with h4 | h4
  exacts [case_00000 a b E hb h0 h1 h2 h3 h4 M hP,
    case_00001 a b E hb h0 h1 h2 h3 h4 M hP,
    case_00010 a b E hb h0 h1 h2 h3 h4 M hP,
    case_00011 a b E hb h0 h1 h2 h3 h4 M hP,
    case_00100 a b E hb h0 h1 h2 h3 h4 M hP,
