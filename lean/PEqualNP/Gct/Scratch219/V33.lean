theorem F_eq_perm (M : E) : F M = (Matrix.of fun i j => M (i, j)).permanent := by
  rw [← Matrix.permanent_transpose]
  unfold F Matrix.permanent
  symm
  refine Fintype.sum_bijective (fun σ : Equiv.Perm (Fin 3) => σ.toEmbedding) ⟨?_, ?_⟩ _ _ ?_
  · intro σ τ h
    ext i
    exact congrArg (fun e : Fin 3 ↪ Fin 3 => (e i : ℕ)) h
  · intro e
    refine ⟨Equiv.ofBijective e (Finite.injective_iff_bijective.1 e.injective), ?_⟩
    ext i
    rfl
  · intro σ
    rfl

theorem level_of_levelF (L : Submodule ℂ E) (hL : LevelF L) : Level L := by
  intro t ht
  have h := hL t ht
  rw [F_one, F_eq_perm] at h
  rw [h]
  simp [Fintype.card_embedding_eq, Nat.descFactorial]

theorem no_four (L : Submodule ℂ E) (hL : LevelF L) : Module.finrank ℂ L < 4 := by
  refine finrank_lt_of_cells 4 (fun L hL _ S v hc hE hmin => ?_) L hL
  have hS : S ∈ powersetCard 4 (univ : Finset (Fin 3 × Fin 3)) :=
    mem_powersetCard.2 ⟨subset_univ _, hc⟩
  have hL' := level_of_levelF L hL
  fin_cases hS <;> first
    | exact fk_row L hL (by norm_num) _ v hE 0 (by decide)
    | exact cell_5 L hL' _ v hE (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    | exact cell_7 L hL' _ v hE (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    | exact cell_10 L hL' _ v hE (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    | exact cell_15 L hL' _ v hE (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    | exact cell_20 L hL' _ v hE (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    | exact cell_37 L hL' _ v hE (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    | exact absurd (hmin (1) (Equiv.swap 0 1)) (by decide)
    | exact absurd (hmin (1) (Equiv.swap 0 2)) (by decide)
    | exact absurd (hmin (1) (Equiv.swap 1 2)) (by decide)
    | exact absurd (hmin (1) (Equiv.swap 0 1 * Equiv.swap 1 2)) (by decide)
    | exact absurd (hmin (1) (Equiv.swap 1 2 * Equiv.swap 0 1)) (by decide)
    | exact absurd (hmin (Equiv.swap 0 1) (1)) (by decide)
    | exact absurd (hmin (Equiv.swap 0 1) (Equiv.swap 0 1)) (by decide)
    | exact absurd (hmin (Equiv.swap 0 1) (Equiv.swap 0 2)) (by decide)
